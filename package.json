{
  "name": "react-view-splitter-repo",
  "version": "1.0.0-alpha.1",
  "description": "React view splitter component",
  "type": "module",
  "homepage": "https://ivp-dev.github.io/react-view-splitter",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivp-dev/react-view-splitter.git"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "clean": "turbo clean",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "deploy": "gh-pages -d dist",
    "types:check": "turbo types:check",
    "test": "vitest run --config ./.vitest/vitest.config.ts",
    "lint:check": "eslint . --max-warnings 0 --flag unstable_ts_config --flag unstable_config_lookup_from_file",
    "lint:fix": "eslint . --fix --max-warnings 0 --flag unstable_ts_config --flag unstable_config_lookup_from_file"
  },
  "keywords": [
    "react",
    "split",
    "view-splitter",
    "splitter"
